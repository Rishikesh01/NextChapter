{
  "name": "@nextchapter/api-client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "generate": "mkdir -p .cache && swagger2openapi ../../backend/internal/swaggerdocs/swagger.yaml --outfile .cache/openapi.json && openapi-typescript .cache/openapi.json -o src/generated/api.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "openapi-typescript": "7.13.0",
    "swagger2openapi": "7.0.8",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
