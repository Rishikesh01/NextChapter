# Build artefacts
backend/bin/

# Local SQLite databases
*.db
*.db-shm
*.db-wal

# Environment overrides
.env
.env.*

# Editor / OS noise
.vscode/
.idea/
.DS_Store

# Coverage / profiling
*.out
coverage.txt

# Node / frontend track
node_modules/
*.tsbuildinfo

# WXT build output
.output/
.wxt/

# Playwright
playwright-report/
test-results/
blob-report/
web-ext-artifacts/

# Generated intermediates (committed output lives in src/generated/)
packages/api-client/.cache/

# Web SPA build output
web/dist/

# Release artefacts (make dist)
/dist/

# Embedded copy of the web build (make -C frontend web-embed) — only the
# committed placeholder index.html stays in git; a locally-embedded real
# build shows index.html as modified on purpose (web-unembed restores it).
backend/internal/webui/dist/*
!backend/internal/webui/dist/index.html
